# Copy this file to ".env" and edit. Never commit or share ".env".

# --- Database (the MySQL you run locally or on AWS RDS) ---
MAP_DB_MODE=remote
MAP_DB_HOST=127.0.0.1
MAP_DB_PORT=3306
MAP_DB_USER=root
MAP_DB_NAME=map_compliance
MAP_DB_PASS=change-me

# --- Login for the web app ---
# If APP_PASSWORD is empty the app has NO login (acceptable only on your own computer).
APP_USER=admin
APP_PASSWORD=change-me-too

# --- Optional: keep project files somewhere else (default: ./MAP_Compliance_Project) ---
# MAP_PROJECT_DIR=C:/MAP_Compliance_Project
